# ── Kiosk PC (main API + STT/NLU + frontend) ───────────────────────────────────
# Copy to .env on the machine that runs:
#   scripts/start-kiosk-api.ps1  →  :8000
#   frontend npm run dev:all     →  :5173 agent, :5174 admin
#   scripts/run-kiosk-tunnel.ps1 →  agent/admin.sarastralabs.com (optional)
#
# For single-PC lab demo use .env.local-pc.example instead.

# MongoDB Atlas (optional)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=bank_assistant

# Customer banking store (production-shaped). sqlite auto-seeds from demo_accounts.json
BANK_CUSTOMER_STORE=sqlite
BANK_CUSTOMER_DB_PATH=data/customer_banking.db
BANK_DEMO_ACCOUNT_LENGTH=10

# ── TTS (remote Parler on 8 GB GPU box) ────────────────────────────────────────
BANK_TTS_ENGINE=auto
BANK_TTS_ALLOW_MMS=0
BANK_TTS_SPEAKER=Suresh
# Public (via Cloudflare tunnel on TTS box):
BANK_TTS_REMOTE_URL=https://tts.sarastralabs.com
# Same LAN — faster, skip Cloudflare for synthesis:
# BANK_TTS_REMOTE_URL=http://192.168.x.x:8001
# Must match .env on TTS GPU box exactly:
BANK_TTS_REMOTE_KEY=CHANGE_ME-must-match-tts-box
BANK_TTS_REMOTE_TIMEOUT=90
BANK_TTS_REMOTE_RETRIES=2
BANK_TTS_REMOTE_USER_AGENT=SarastraBankAssistant/1.0 (+https://sarastralabs.com)
# Must match BANK_TTS_CACHE_VERSION on the TTS box (bump to drop old cached audio).
BANK_TTS_CACHE_VERSION=v2

# Optional: in-memory TTS phrase cache size on this API (default 160)
# BANK_TTS_CACHE_MAX=256

# Pre-warm lobby greet WAVs before demo (uses remote TTS):
# py -3.12 scripts/warm_greetings.py --first-only --remote
# API startup also prewarms phrases + variant-0 greets when remote is ready.

# ── Pipeline (STT / translate / NLU on this machine) ───────────────────────────
BANK_PIPELINE_KEEP_LOADED=1
BANK_PIPELINE_WORKER=1
BANK_PIPELINE_WARM_ON_START=1
# vasista-medium (default); set specialized for immediate VAANI rollback
BANK_STT_MODEL=vasista-medium
BANK_NLU_MIN_CONF=0.35
BANK_NLU_MAX_CLARIFY=3

# ── Admin console (change before public demo) ──────────────────────────────────
BANK_ADMIN_USER=admin
BANK_ADMIN_PASS=CHANGE_ME-strong-password

# ── Cloudflare public URLs (optional) ──────────────────────────────────────────
# Tunnel: scripts/ensure-tunnel-config.ps1 routes /api → :8000 (faster than Vite proxy)
# Prod UI: scripts/run-kiosk-prod.ps1 (static build instead of Vite dev)
# BANK_CORS_ORIGINS=https://agent.sarastralabs.com,https://admin.sarastralabs.com

TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
