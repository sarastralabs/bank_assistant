# ── TTS Engine ────────────────────────────────────────────────────────────────
# Use MMS-TTS (facebook/mms-tts-kan) — no dependency conflicts.
# parler-tts is BROKEN with transformers>=4.50 (10 missing GenerationMixin methods).
# Do not set BANK_TTS_ENGINE=parler unless you have a working parler venv.
BANK_TTS_ENGINE=mms
BANK_TTS_ALLOW_MMS=1
BANK_TTS_SPEAKER=Suresh

# ── Offline mode — all models loaded from local cache ─────────────────────────
# Set these so HuggingFace never tries to reach the internet.
# Remove these lines only when you want to re-download model updates.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1

# ── Pipeline worker ───────────────────────────────────────────────────────────
# Keep models warm between requests (much faster after first query).
# Set to 0 to use memory-safe sequential unload (slower but safer on low RAM).
BANK_PIPELINE_KEEP_LOADED=1
BANK_PIPELINE_WORKER=1
