# Copy to .env on first setup. Do NOT commit .env with secrets to git.
#
# Use the profile that matches your machine:
#   .env.tts.example      → 8 GB GPU box (Parler only) — scripts/setup_tts_box.ps1
#   .env.kiosk.example    → Kiosk PC (STT/NLU/API + remote TTS)
#   .env.local-pc.example   → Single PC (TTS :8001 + API :8000 on same machine)
#
# See docs/DEPLOYMENT.md

# MongoDB Atlas (optional — SQLite used when unset)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=bank_assistant

# Customer store: json (demo file) | sqlite (local production-shaped DB — recommended for kiosk)
BANK_CUSTOMER_STORE=sqlite
BANK_CUSTOMER_DB_PATH=data/customer_banking.db
BANK_DEMO_ACCOUNT_LENGTH=10

# ── TTS (remote Parler on GPU box) ─────────────────────────────────────────────
BANK_TTS_ENGINE=auto
BANK_TTS_ALLOW_MMS=0
BANK_TTS_SPEAKER=Suresh
BANK_TTS_REMOTE_URL=https://tts.sarastralabs.com
# Same LAN (faster, no Cloudflare hop): BANK_TTS_REMOTE_URL=http://192.168.x.x:8001
BANK_TTS_REMOTE_KEY=CHANGE_ME-must-match-tts-box
BANK_TTS_REMOTE_TIMEOUT=90
BANK_TTS_REMOTE_RETRIES=2
# Required when TTS is behind Cloudflare (avoids error 1010):
BANK_TTS_REMOTE_USER_AGENT=SarastraBankAssistant/1.0 (+https://sarastralabs.com)
# Must match BANK_TTS_CACHE_VERSION on the TTS box (bump to drop old cached audio).
BANK_TTS_CACHE_VERSION=v2

# ── Pipeline (STT / translate / NLU on kiosk PC) ───────────────────────────────
BANK_PIPELINE_KEEP_LOADED=1
BANK_PIPELINE_WORKER=1
BANK_PIPELINE_WARM_ON_START=1
# STT: vasista-medium (default) | specialized (VAANI rollback) | baseline
BANK_STT_MODEL=vasista-medium
BANK_NLU_MIN_CONF=0.35
BANK_NLU_MAX_CLARIFY=3

# ── Admin console ──────────────────────────────────────────────────────────────
BANK_ADMIN_USER=admin
BANK_ADMIN_PASS=CHANGE_ME-strong-password

# ── CORS (only if using domains not covered by api/cors_config.py regex) ───────
# BANK_CORS_ORIGINS=https://agent.sarastralabs.com,https://admin.sarastralabs.com

# Offline models (kiosk — models must exist under models/)
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
