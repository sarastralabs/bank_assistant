# ── Single PC (TTS + API + frontend on one machine) ────────────────────────────
# Copy to .env for lab demo on one laptop/PC with GPU.
#
# Start order:
#   1. scripts/run_tts_server.ps1     →  :8001  (use .env.tts.example on TTS side)
#   2. scripts/start-kiosk-api.ps1    →  :8000
#   3. frontend npm run dev:all       →  :5173 / :5174
#
# Or: scripts/start-local-all.ps1

# MongoDB Atlas (optional)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=bank_assistant

# ── TTS (local Parler process on same PC) ──────────────────────────────────────
BANK_TTS_ENGINE=auto
BANK_TTS_ALLOW_MMS=1
BANK_TTS_SPEAKER=Suresh
BANK_TTS_REMOTE_URL=http://127.0.0.1:8001
BANK_TTS_REMOTE_KEY=CHANGE_ME-local-dev-secret
BANK_TTS_REMOTE_TIMEOUT=90
BANK_TTS_REMOTE_RETRIES=2
BANK_TTS_REMOTE_USER_AGENT=SarastraBankAssistant/1.0 (+https://sarastralabs.com)
# Must match BANK_TTS_CACHE_VERSION on the TTS box (bump to drop old cached audio).
BANK_TTS_CACHE_VERSION=v2

# ── Pipeline ───────────────────────────────────────────────────────────────────
BANK_PIPELINE_KEEP_LOADED=1
BANK_PIPELINE_WORKER=1
BANK_PIPELINE_WARM_ON_START=1
BANK_STT_MODEL=vasista-medium
BANK_NLU_MIN_CONF=0.35
BANK_NLU_MAX_CLARIFY=3

# ── Admin (dev only — change for demos) ────────────────────────────────────────
BANK_ADMIN_USER=admin
BANK_ADMIN_PASS=bank@123

TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1

# TTS process uses .env.tts.example settings via run_tts_server.ps1:
# BANK_PARLER_DTYPE=fp16  BANK_PARLER_DO_SAMPLE=0  BANK_TTS_CACHE_MAX=512
